{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Prometheus datasource for CNPG metrics",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "10.0.0"
    },
    {
      "type": "datasource",
      "id": "prometheus",
      "name": "Prometheus",
      "version": "1.0.0"
    },
    {
      "type": "panel",
      "id": "timeseries",
      "name": "Time series",
      "version": ""
    },
    {
      "type": "panel",
      "id": "stat",
      "name": "Stat",
      "version": ""
    },
    {
      "type": "panel",
      "id": "gauge",
      "name": "Gauge",
      "version": ""
    },
    {
      "type": "panel",
      "id": "table",
      "name": "Table",
      "version": ""
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": "-- Grafana --",
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "CloudNativePG PostgreSQL cluster monitoring: connections, replication, WAL, storage, and backup health.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "Cluster Overview",
      "type": "row"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          },
          "mappings": [
            { "options": { "0": { "text": "DOWN" } }, "type": "value" },
            { "options": { "1": { "text": "UP" } }, "type": "value" }
          ]
        }
      },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "id": 1,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "cnpg_collector_up{namespace=~\"$namespace\", cluster_name=~\"$cluster\"}",
          "legendFormat": "{{ pod }}"
        }
      ],
      "title": "Instance Status",
      "type": "stat"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 3 },
              { "color": "red", "value": 5 }
            ]
          },
          "unit": "s"
        }
      },
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 1 },
      "id": 2,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "targets": [
        {
          "expr": "max(cnpg_pg_replication_lag{namespace=~\"$namespace\", cluster_name=~\"$cluster\"})",
          "legendFormat": "Max Lag"
        }
      ],
      "title": "Max Replication Lag",
      "type": "stat"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 150 },
              { "color": "red", "value": 190 }
            ]
          }
        }
      },
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 1 },
      "id": 3,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "targets": [
        {
          "expr": "sum(cnpg_pg_stat_activity_count{namespace=~\"$namespace\", cluster_name=~\"$cluster\"}) by (pod)",
          "legendFormat": "{{ pod }}"
        }
      ],
      "title": "Active Connections",
      "type": "stat"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 40000000000 },
              { "color": "red", "value": 48000000000 }
            ]
          },
          "unit": "bytes"
        }
      },
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 1 },
      "id": 4,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "targets": [
        {
          "expr": "max(cnpg_pg_database_size_bytes{namespace=~\"$namespace\", cluster_name=~\"$cluster\"}) by (pod)",
          "legendFormat": "{{ pod }}"
        }
      ],
      "title": "Database Size",
      "type": "stat"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        }
      },
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 1 },
      "id": 5,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "targets": [
        {
          "expr": "sum(cnpg_pg_stat_archiver_failed_count{namespace=~\"$namespace\", cluster_name=~\"$cluster\"})",
          "legendFormat": "Failed Archives"
        }
      ],
      "title": "WAL Archive Failures",
      "type": "stat"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null }
            ]
          },
          "unit": "s"
        }
      },
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 1 },
      "id": 6,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "targets": [
        {
          "expr": "time() - max(cnpg_pg_stat_archiver_last_archived_time{namespace=~\"$namespace\", cluster_name=~\"$cluster\"})",
          "legendFormat": "Since Last Archive"
        }
      ],
      "title": "Time Since Last WAL Archive",
      "type": "stat"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "id": 101,
      "title": "Connections",
      "type": "row"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "fillOpacity": 20,
            "lineWidth": 2,
            "spanNulls": false,
            "stacking": { "mode": "none" }
          },
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "max_connections" },
            "properties": [
              { "id": "custom.lineStyle", "value": { "dash": [10, 10], "fill": "dash" } },
              { "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } },
              { "id": "custom.fillOpacity", "value": 0 }
            ]
          }
        ]
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "id": 10,
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "expr": "cnpg_pg_stat_activity_count{namespace=~\"$namespace\", cluster_name=~\"$cluster\"}",
          "legendFormat": "{{ pod }} - total"
        },
        {
          "expr": "cnpg_pg_settings_setting{name=\"max_connections\", namespace=~\"$namespace\", cluster_name=~\"$cluster\"}",
          "legendFormat": "max_connections"
        }
      ],
      "title": "Total Connections vs Max",
      "type": "timeseries"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "fillOpacity": 30,
            "lineWidth": 2,
            "stacking": { "mode": "normal" }
          },
          "unit": "short"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "id": 11,
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "expr": "cnpg_pg_stat_activity_count{namespace=~\"$namespace\", cluster_name=~\"$cluster\", state=\"active\"}",
          "legendFormat": "{{ pod }} - active"
        },
        {
          "expr": "cnpg_pg_stat_activity_count{namespace=~\"$namespace\", cluster_name=~\"$cluster\", state=\"idle\"}",
          "legendFormat": "{{ pod }} - idle"
        },
        {
          "expr": "cnpg_pg_stat_activity_count{namespace=~\"$namespace\", cluster_name=~\"$cluster\", state=\"idle in transaction\"}",
          "legendFormat": "{{ pod }} - idle in txn"
        }
      ],
      "title": "Connections by State",
      "type": "timeseries"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "continuous-GrYlRd" },
          "max": 1,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.7 },
              { "color": "red", "value": 0.9 }
            ]
          },
          "unit": "percentunit"
        }
      },
      "gridPos": { "h": 5, "w": 12, "x": 0, "y": 14 },
      "id": 12,
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "targets": [
        {
          "expr": "cnpg_pg_stat_activity_count{namespace=~\"$namespace\", cluster_name=~\"$cluster\"} / cnpg_pg_settings_setting{name=\"max_connections\", namespace=~\"$namespace\", cluster_name=~\"$cluster\"}",
          "legendFormat": "{{ pod }}"
        }
      ],
      "title": "Connection Utilization",
      "type": "gauge"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "fillOpacity": 10, "lineWidth": 2 },
          "unit": "s"
        }
      },
      "gridPos": { "h": 5, "w": 12, "x": 12, "y": 14 },
      "id": 13,
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "expr": "cnpg_pg_stat_activity_max_tx_duration_seconds{namespace=~\"$namespace\", cluster_name=~\"$cluster\"}",
          "legendFormat": "{{ pod }}"
        }
      ],
      "title": "Longest Running Transaction",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 19 },
      "id": 102,
      "title": "Replication",
      "type": "row"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "fillOpacity": 20, "lineWidth": 2 },
          "unit": "s"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "id": 20,
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "expr": "cnpg_pg_replication_lag{namespace=~\"$namespace\", cluster_name=~\"$cluster\"}",
          "legendFormat": "{{ pod }}"
        }
      ],
      "title": "Replication Lag (seconds)",
      "type": "timeseries"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [
            { "options": { "0": { "color": "red", "text": "Not Streaming" } }, "type": "value" },
            { "options": { "1": { "color": "green", "text": "Streaming" } }, "type": "value" }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
      "id": 21,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "cnpg_pg_replication_streaming{namespace=~\"$namespace\", cluster_name=~\"$cluster\"}",
          "legendFormat": "{{ pod }}"
        }
      ],
      "title": "Replication Streaming Status",
      "type": "stat"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 28 },
      "id": 103,
      "title": "WAL & Backups",
      "type": "row"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "fillOpacity": 10, "lineWidth": 2 },
          "unit": "bytes"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 29 },
      "id": 30,
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "expr": "cnpg_pg_wal_storage_size_bytes{namespace=~\"$namespace\", cluster_name=~\"$cluster\"}",
          "legendFormat": "{{ pod }} - WAL size"
        }
      ],
      "title": "WAL Storage Size",
      "type": "timeseries"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "fillOpacity": 10, "lineWidth": 2 },
          "unit": "ops"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 29 },
      "id": 31,
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "expr": "rate(cnpg_pg_stat_archiver_archived_count{namespace=~\"$namespace\", cluster_name=~\"$cluster\"}[$__rate_interval])",
          "legendFormat": "{{ pod }} - archived/s"
        },
        {
          "expr": "rate(cnpg_pg_stat_archiver_failed_count{namespace=~\"$namespace\", cluster_name=~\"$cluster\"}[$__rate_interval])",
          "legendFormat": "{{ pod }} - failed/s"
        }
      ],
      "title": "WAL Archiving Rate",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 37 },
      "id": 104,
      "title": "Storage & I/O",
      "type": "row"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "fillOpacity": 20, "lineWidth": 2 },
          "unit": "bytes"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 38 },
      "id": 40,
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "expr": "cnpg_pg_database_size_bytes{namespace=~\"$namespace\", cluster_name=~\"$cluster\"}",
          "legendFormat": "{{ pod }} - {{ datname }}"
        }
      ],
      "title": "Database Size by Instance",
      "type": "timeseries"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "fillOpacity": 10, "lineWidth": 2 },
          "unit": "short"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 38 },
      "id": 41,
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "expr": "rate(cnpg_pg_stat_bgwriter_buffers_checkpoint{namespace=~\"$namespace\", cluster_name=~\"$cluster\"}[$__rate_interval])",
          "legendFormat": "{{ pod }} - checkpoint buffers/s"
        },
        {
          "expr": "rate(cnpg_pg_stat_bgwriter_buffers_backend{namespace=~\"$namespace\", cluster_name=~\"$cluster\"}[$__rate_interval])",
          "legendFormat": "{{ pod }} - backend buffers/s"
        }
      ],
      "title": "Buffer Writes",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 46 },
      "id": 105,
      "title": "Transactions & Queries",
      "type": "row"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "fillOpacity": 10, "lineWidth": 2 },
          "unit": "ops"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 47 },
      "id": 50,
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "expr": "rate(cnpg_pg_stat_database_xact_commit{namespace=~\"$namespace\", cluster_name=~\"$cluster\"}[$__rate_interval])",
          "legendFormat": "{{ pod }} - commits/s"
        },
        {
          "expr": "rate(cnpg_pg_stat_database_xact_rollback{namespace=~\"$namespace\", cluster_name=~\"$cluster\"}[$__rate_interval])",
          "legendFormat": "{{ pod }} - rollbacks/s"
        }
      ],
      "title": "Transaction Rate",
      "type": "timeseries"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "fillOpacity": 10, "lineWidth": 2 },
          "unit": "short"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 47 },
      "id": 51,
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "expr": "rate(cnpg_pg_stat_database_tup_returned{namespace=~\"$namespace\", cluster_name=~\"$cluster\"}[$__rate_interval])",
          "legendFormat": "{{ pod }} - rows returned/s"
        },
        {
          "expr": "rate(cnpg_pg_stat_database_tup_fetched{namespace=~\"$namespace\", cluster_name=~\"$cluster\"}[$__rate_interval])",
          "legendFormat": "{{ pod }} - rows fetched/s"
        },
        {
          "expr": "rate(cnpg_pg_stat_database_tup_inserted{namespace=~\"$namespace\", cluster_name=~\"$cluster\"}[$__rate_interval])",
          "legendFormat": "{{ pod }} - rows inserted/s"
        },
        {
          "expr": "rate(cnpg_pg_stat_database_tup_updated{namespace=~\"$namespace\", cluster_name=~\"$cluster\"}[$__rate_interval])",
          "legendFormat": "{{ pod }} - rows updated/s"
        },
        {
          "expr": "rate(cnpg_pg_stat_database_tup_deleted{namespace=~\"$namespace\", cluster_name=~\"$cluster\"}[$__rate_interval])",
          "legendFormat": "{{ pod }} - rows deleted/s"
        }
      ],
      "title": "Row Operations",
      "type": "timeseries"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "fillOpacity": 10, "lineWidth": 2 },
          "unit": "percentunit"
        }
      },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 55 },
      "id": 52,
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "expr": "cnpg_pg_stat_database_blk_hit_ratio{namespace=~\"$namespace\", cluster_name=~\"$cluster\"}",
          "legendFormat": "{{ pod }} - cache hit ratio"
        }
      ],
      "title": "Buffer Cache Hit Ratio",
      "type": "timeseries"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["cnpg", "postgresql", "database", "kubernetes"],
  "templating": {
    "list": [
      {
        "current": {},
        "datasource": "${DS_PROMETHEUS}",
        "definition": "label_values(cnpg_collector_up, namespace)",
        "hide": 0,
        "includeAll": true,
        "multi": true,
        "name": "namespace",
        "query": "label_values(cnpg_collector_up, namespace)",
        "refresh": 2,
        "regex": "",
        "sort": 1,
        "type": "query"
      },
      {
        "current": {},
        "datasource": "${DS_PROMETHEUS}",
        "definition": "label_values(cnpg_collector_up{namespace=~\"$namespace\"}, cluster_name)",
        "hide": 0,
        "includeAll": true,
        "multi": true,
        "name": "cluster",
        "query": "label_values(cnpg_collector_up{namespace=~\"$namespace\"}, cluster_name)",
        "refresh": 2,
        "regex": "",
        "sort": 1,
        "type": "query"
      }
    ]
  },
  "time": { "from": "now-3h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "CNPG PostgreSQL Cluster",
  "uid": "cnpg-postgresql-cluster",
  "version": 1
}
